# --- Required -------------------------------------------------------------
# UniFi console IP or hostname (UDM, UDR, UNVR, Cloud Key, etc.)
UNIFI_HOST=192.168.1.1

# Local admin credentials. Create a local-only admin in your UniFi console:
#   Settings > Admins & Users > Add Admin > Restrict to local access only
# Do NOT use your Ubiquiti SSO account.
UNIFI_USERNAME=localuser
UNIFI_PASSWORD=change-me

# --- Optional -------------------------------------------------------------
# Seconds between full sweeps. The container stays alive and re-scans on
# this interval to catch new detections as they appear.
POLL_INTERVAL=300

# Base delay between enhance requests (seconds). The script adapts this
# dynamically based on the AI Key's 200-event queue depth.
BASE_DELAY=0.35

# Only enhance detections that haven't been enhanced yet.
ONLY_UNENHANCED=true

# Restrict to a specific person by name. Leave blank to enhance every group.
# Example: GROUP_FILTER=John Smith
GROUP_FILTER=

# Cap per cycle. 0 = unlimited.
LIMIT=0

# List detections without actually enhancing them.
DRY_RUN=false

# Run exactly one cycle and exit (useful for cron-style usage).
RUN_ONCE=false

# Number of parallel workers used to fetch detections from face groups.
# Large systems can have 1000+ groups; the default of 8 fetches roughly 8x
# faster than serial. Set to 1 to disable threading.
FETCH_WORKERS=8

# Also enhance "unknown" and "degraded" faces. Protect keeps these OUT of the
# /recognition/face/groups listing — they only exist as references inside
# events — so without this the enhancer never touches them (this was the cause
# of "unknown faces aren't being enhanced"). When true, each cycle harvests
# those unlisted groups (same sliding-window walk the triage view uses, tuned
# by PHANTOM_WINDOWS / PHANTOM_EVENT_LIMIT below) and enhances them too. This
# can add a large one-off backlog on first run; the adaptive throttle paces it.
ENHANCE_PHANTOMS=true

# --- Face Triage webapp ---------------------------------------------------
# Built-in webapp for fast face-group triage (merge unnamed clusters into
# named identities with keyboard shortcuts). Browse to http://<host>:8080.
WEBAPP_ENABLED=true
WEBAPP_PORT=8080
WEBAPP_HOST=0.0.0.0

# Disable the periodic enhancer loop if you ONLY want the webapp (rare).
ENHANCER_ENABLED=true

# --- Face harvest depth (triage view + ENHANCE_PHANTOMS) ------------------
# Protect's /events endpoint is capped at ~1000 results (~30h) per request and
# ignores paging, so both the triage view and the enhancer's ENHANCE_PHANTOMS
# sweep walk a sliding window to surface EVERY face — including the
# face_degraded_* singletons and brand-new clusters that never show up in
# /recognition/face/groups. Each window reaches ~1 day further back. Bump
# PHANTOM_WINDOWS for a deeper one-off sweep of old faces.
PHANTOM_WINDOWS=4
# Max events fetched per window (server caps around 1000).
PHANTOM_EVENT_LIMIT=1000
# Seconds to cache the harvested set (it's several sequential requests).
PHANTOM_CACHE_TTL=45

# --- AI suggest (optional) ------------------------------------------------
# Powers two matchers for unnamed faces in the webapp:
#   "⚡ Auto-match" — classifies all loaded unnamed faces at once and shows a
#                     bulk review list (confident matches pre-checked).
#   "🤖 AI suggest" — steps through faces one at a time with a Y/N prompt.
# Either way YOU confirm before anything merges — nothing auto-merges silently.
#
# Pick a backend with AI_PROVIDER:
#   local  — on-device OpenVINO + ArcFace face embeddings. FREE, fast, private.
#            No API key, no per-call cost. Runs on your CPU (or Intel iGPU).
#            This is the embedding approach Frigate / CompreFace / Scrypted use,
#            and it's more accurate than the cloud VLM for "same person?".
#   gemini — Google Gemini cloud VLM. Costs per call (scales with #identities).
#   auto   — (default) gemini if GEMINI_API_KEY is set, else local.
AI_PROVIDER=auto

# --- Local backend (AI_PROVIDER=local) ------------------------------------
# Device for OpenVINO inference: CPU (default, most reliable), GPU (Intel iGPU),
# or AUTO. Check what OpenVINO sees at GET /api/ai/status -> availableDevices.
#
# To use the iGPU (GPU): you need a LINUX Docker host (not Docker Desktop on
# Windows/macOS — its WSL2 GPU isn't reachable as /dev/dri). Then:
#   1) uncomment the `devices:` + `group_add:` block in docker-compose.yml
#   2) set RENDER_GID below to your host's render group GID:
#        getent group render | cut -d: -f3
#   3) set OPENVINO_DEVICE=GPU
# Note: this ArcFace model is tiny, so on a strong CPU the iGPU isn't always
# faster per call — its win is offloading the CPU / large batches.
OPENVINO_DEVICE=CPU
# Host render-group GID for iGPU passthrough (see above). Only used if you
# uncomment the GPU block in docker-compose.yml.
RENDER_GID=993
# Recognition model pack (auto-downloaded on first use to LOCAL_MODEL_DIR),
# weakest -> strongest:
#   buffalo_s  — MobileFaceNet, lightest/fastest          (~13 MB)
#   buffalo_l  — ResNet50 ArcFace, strong default         (~166 MB) [default]
#   antelopev2 — ResNet100 / Glint360K, most accurate     (~260 MB, ~2x slower)
LOCAL_FACE_PACK=buffalo_l
# Or point at your own ArcFace .onnx / OpenVINO .xml and skip the download:
# LOCAL_FACE_MODEL=/models/w600k_r50.onnx

# Face detection + alignment. ArcFace is trained on landmark-aligned faces, so
# this is essential for accuracy — leave it ON. When true (default), a YuNet
# detector (~350 KB, auto-downloaded) finds the face and warps it to ArcFace's
# canonical layout before embedding. Turn off only to debug.
LOCAL_ALIGN=true
# LOCAL_DETECT_MODEL=/models/face_detection_yunet_2023mar.onnx  # bring your own
LOCAL_DETECT_SCORE=0.5       # detector confidence floor (lower = detects more)

# Multi-sample matching: compare against several crops per face (a "gallery")
# instead of one reference photo — much more robust to bad angles/lighting.
# AI_GALLERY_SAMPLES = crops per face (1 = old single-photo behaviour).
# LOCAL_GALLERY_TOPK = identity score is the mean of the top-K query x gallery
# cosine pairs. More samples = better accuracy but more embeddings on first run.
AI_GALLERY_SAMPLES=5
LOCAL_GALLERY_TOPK=3

# Cosine-similarity calibration. Below UNKNOWN -> "no match"; at/above STRONG
# -> ~1.0 confidence (so the UI pre-checks it). With alignment + galleries true
# matches score high and non-matches low, so 0.40 is a good floor; raise it if
# you still get false matches, lower it if real matches are missed.
LOCAL_SIM_UNKNOWN=0.40
LOCAL_SIM_STRONG=0.55

# --- Gemini backend (AI_PROVIDER=gemini, or auto with a key) ---------------
# Get an API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Model. Matching sends the query face PLUS all your reference faces on every
# call, so cost scales with how many identities you have. Pick the cheapest
# tier that's accurate enough — this is the #1 lever on your bill.
#   gemini-2.5-flash-lite (default) — cheapest; fine for most matching
#   gemini-2.5-flash                — more accurate, ~3-5x pricier
#   gemini-2.5-pro                  — most accurate, most expensive
GEMINI_MODEL=gemini-2.5-flash-lite
# Parallel workers for the ⚡ Auto-match batch matcher. Higher = faster but
# more concurrent Gemini calls (watch your rate limit).
AI_BATCH_WORKERS=6
# Hard cap on faces per ⚡ Auto-match run — stops one click from firing a huge
# number of billable calls (the UI also asks you to confirm). 0 = no cap.
AI_BATCH_MAX=50
