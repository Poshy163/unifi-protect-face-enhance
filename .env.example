# --- Required -------------------------------------------------------------
# UniFi console IP or hostname (UDM, UDR, UNVR, Cloud Key, etc.)
UNIFI_HOST=192.168.1.1

# Local admin credentials. Create a local-only admin in your UniFi console:
#   Settings > Admins & Users > Add Admin > Restrict to local access only
# Do NOT use your Ubiquiti SSO account.
UNIFI_USERNAME=localuser
UNIFI_PASSWORD=change-me

# --- Optional -------------------------------------------------------------
# Seconds between full sweeps. The container stays alive and re-scans on
# this interval to catch new detections as they appear.
POLL_INTERVAL=300

# Base delay between enhance requests (seconds). The script adapts this
# dynamically based on the AI Key's 200-event queue depth.
BASE_DELAY=0.35

# Only enhance detections that haven't been enhanced yet.
ONLY_UNENHANCED=true

# Restrict to a specific person by name. Leave blank to enhance every group.
# Example: GROUP_FILTER=John Smith
GROUP_FILTER=

# Cap per cycle. 0 = unlimited.
LIMIT=0

# List detections without actually enhancing them.
DRY_RUN=false

# Run exactly one cycle and exit (useful for cron-style usage).
RUN_ONCE=false
