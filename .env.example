# --- Required -------------------------------------------------------------
# UniFi console IP or hostname (UDM, UDR, UNVR, Cloud Key, etc.)
UNIFI_HOST=192.168.1.1

# Local admin credentials. Create a local-only admin in your UniFi console:
#   Settings > Admins & Users > Add Admin > Restrict to local access only
# Do NOT use your Ubiquiti SSO account.
UNIFI_USERNAME=localuser
UNIFI_PASSWORD=change-me

# --- Optional -------------------------------------------------------------
# Seconds between full sweeps. The container stays alive and re-scans on
# this interval to catch new detections as they appear.
POLL_INTERVAL=300

# Base delay between enhance requests (seconds). The script adapts this
# dynamically based on the AI Key's 200-event queue depth.
BASE_DELAY=0.35

# Only enhance detections that haven't been enhanced yet.
ONLY_UNENHANCED=true

# Restrict to a specific person by name. Leave blank to enhance every group.
# Example: GROUP_FILTER=John Smith
GROUP_FILTER=

# Cap per cycle. 0 = unlimited.
LIMIT=0

# List detections without actually enhancing them.
DRY_RUN=false

# Run exactly one cycle and exit (useful for cron-style usage).
RUN_ONCE=false

# Number of parallel workers used to fetch detections from face groups.
# Large systems can have 1000+ groups; the default of 8 fetches roughly 8x
# faster than serial. Set to 1 to disable threading.
FETCH_WORKERS=8

# --- Face Triage webapp ---------------------------------------------------
# Built-in webapp for fast face-group triage (merge unnamed clusters into
# named identities with keyboard shortcuts). Browse to http://<host>:8080.
WEBAPP_ENABLED=true
WEBAPP_PORT=8080
WEBAPP_HOST=0.0.0.0

# Disable the periodic enhancer loop if you ONLY want the webapp (rare).
ENHANCER_ENABLED=true

# --- Face harvest depth (webapp triage) -----------------------------------
# Protect's /events endpoint is capped at ~1000 results (~30h) per request and
# ignores paging, so the triage view walks a sliding window to surface EVERY
# face — including the face_degraded_* singletons and brand-new clusters that
# never show up in /recognition/face/groups. Each window reaches ~1 day
# further back. Bump PHANTOM_WINDOWS for a deeper one-off sweep of old faces.
PHANTOM_WINDOWS=4
# Max events fetched per window (server caps around 1000).
PHANTOM_EVENT_LIMIT=1000
# Seconds to cache the harvested set (it's several sequential requests).
PHANTOM_CACHE_TTL=45

# --- AI suggest (optional) ------------------------------------------------
# If set, the webapp exposes two Gemini-powered matchers for unnamed faces:
#   "⚡ Auto-match" — classifies all loaded unnamed faces at once and shows a
#                     bulk review list (confident matches pre-checked).
#   "🤖 AI suggest" — steps through faces one at a time with a Y/N prompt.
# Either way YOU confirm before anything merges — nothing auto-merges silently.
# Get an API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Model. Matching sends the query face PLUS all your reference faces on every
# call, so cost scales with how many identities you have. Pick the cheapest
# tier that's accurate enough — this is the #1 lever on your bill.
#   gemini-2.5-flash-lite (default) — cheapest; fine for most matching
#   gemini-2.5-flash                — more accurate, ~3-5x pricier
#   gemini-2.5-pro                  — most accurate, most expensive
GEMINI_MODEL=gemini-2.5-flash-lite
# Parallel workers for the ⚡ Auto-match batch matcher. Higher = faster but
# more concurrent Gemini calls (watch your rate limit).
AI_BATCH_WORKERS=6
# Hard cap on faces per ⚡ Auto-match run — stops one click from firing a huge
# number of billable calls (the UI also asks you to confirm). 0 = no cap.
AI_BATCH_MAX=50
